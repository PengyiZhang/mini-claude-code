# =============================================================================
#  mini_cc configuration
#
#  This file is loaded automatically by `python -m mini_cc.server` if present
#  in the working directory. Copy to `.env` and edit.
#
#  Two LLM backends are supported:
#
#    1. Anthropic-compatible (default)
#       For native Anthropic accounts or any endpoint that exposes the
#       Anthropic Messages API (DeepSeek's /anthropic adapter, GLM, Kimi,
#       MiniMax, Moonshot). Use bare model names with no prefix.
#
#    2. litellm (OpenAI-compatible + 100+ other providers)
#       For any OpenAI-compatible endpoint. Use a provider prefix:
#         openai/gpt-4o-mini
#         deepseek/deepseek-chat
#         qwen/qwen-plus
#         gemini/gemini-1.5-pro
#         groq/llama-3.1-70b-versatile
#       litellm routes based on the prefix. See https://docs.litellm.ai/docs/providers
# =============================================================================

# ---- Model selection (required) ---------------------------------------------
# The model name decides which backend is used:
#   - No prefix (e.g. "claude-sonnet-4-6", "deepseek-chat")
#     → Anthropic SDK path (uses ANTHROPIC_* credentials below)
#   - Prefixed (e.g. "openai/gpt-4o-mini", "deepseek/deepseek-chat")
#     → litellm path (uses LITELLM_* / OPENAI_* credentials)
MODEL_ID=claude-sonnet-4-6

# Optional: model to switch to if the primary is overloaded (Anthropic path)
# FALLBACK_MODEL_ID=claude-haiku-4-5-20251001


# =============================================================================
#  Anthropic backend credentials
#  Used when MODEL_ID has no provider prefix.
# =============================================================================

# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: Anthropic-compatible providers (default = api.anthropic.com)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Anthropic-compatible providers (provider-specific docs) ----------------
#  Provider         MODEL_ID              SWE-bench  Base URL
#  ---------------  --------------------  ---------  ---------------------------
#  Anthropic        claude-sonnet-4-6     79.6%      (default)
#  MiniMax          MiniMax-M2.5          80.2%      https://api.minimax.io/anthropic
#  GLM (Zhipu)      glm-5                 77.8%      https://z.ai/api/anthropic
#  Kimi (Moonshot)  kimi-k2.5             76.8%      https://api.moonshot.ai/anthropic
#  DeepSeek         deepseek-v4-flash     73.0%      https://api.deepseek.com/anthropic


# =============================================================================
#  litellm backend credentials
#  Used when MODEL_ID has a provider prefix like `openai/`, `deepseek/`, etc.
#
#  Two env names are accepted for each (the LITELLM_* form takes priority):
#    - LITELLM_API_KEY  or  OPENAI_API_KEY
#    - LITELLM_BASE_URL or  OPENAI_BASE_URL
# =============================================================================

# For OpenAI directly:
# MODEL_ID=openai/gpt-4o-mini
# LITELLM_API_KEY=sk-xxx
# LITELLM_BASE_URL=https://api.openai.com/v1

# For DeepSeek's native OpenAI-compatible endpoint (more models than /anthropic):
# MODEL_ID=deepseek/deepseek-chat
# LITELLM_API_KEY=sk-xxx
# LITELLM_BASE_URL=https://api.deepseek.com/v1

# For Qwen DashScope:
# MODEL_ID=qwen/qwen-plus
# LITELLM_API_KEY=sk-xxx
# LITELLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# For any other OpenAI-compatible self-hosted endpoint:
# MODEL_ID=openai/<your-model>
# LITELLM_API_KEY=anything
# LITELLM_BASE_URL=http://localhost:11434/v1   # e.g. local Ollama / vLLM


# =============================================================================
#  Server configuration (both backends)
# =============================================================================

# Host/port the HTTP/SSE server binds to
# MINI_CC_HOST=127.0.0.1
# MINI_CC_PORT=8000

# Directory for projects, sessions, keys, metrics (default: ./mini_cc_data)
# MINI_CC_DATA_DIR=./mini_cc_data

# CORS origins allowed to call the API (comma-separated; default: *)
# Set to empty in production when serving the UI from the same origin.
# MINI_CC_CORS_ORIGINS=*

# Rate limiting (requests per minute per tenant)
# MINI_CC_RATE_LIMIT_RPM_DEFAULT=60
# MINI_CC_RATE_LIMIT_RPM=my-tenant=120,other-tenant=30

# Logging: json | text
# MINI_CC_LOG_FORMAT=json
# MINI_CC_LOG_LEVEL=INFO

# =============================================================================
#  Static frontend mount (optional)
#
#  When set (or when mini_cc/web/dist exists), the built React UI is served
#  from the FastAPI app at /. Production deployments use this so only one
#  origin is needed (no CORS). Build the UI with:
#     cd mini_cc/web && npm run build
# =============================================================================

# MINI_CC_WEB_DIST=./mini_cc/web/dist
