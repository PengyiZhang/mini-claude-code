# =============================================================================
#  mini_cc — complete environment variable reference
#
#  This file documents every env var the server reads at boot. Copy to
#  `.env` (or export selectively) and edit. The server auto-loads a
#  sibling `.env` via python-dotenv; CLI flag equivalents, where they
#  exist, take precedence.
#
#  Sections:
#    1. Model selection
#    2. Anthropic backend credentials
#    3. litellm / OpenAI-compatible backend credentials
#    4. Tool integrations
#    5. Server bind + CORS
#    6. Rate limiting
#    7. Logging
#    8. Observability (OpenTelemetry)
#    9. Sandbox (subprocess vs container)
#   10. Static frontend mount
#   11. Plugin discovery (MCP escape hatch)
#
#  Any value commented out is optional and shows its default.
# =============================================================================


# ── 1. Model selection ───────────────────────────────────────────────
# The model name decides which backend is used:
#   - No prefix (e.g. "claude-sonnet-4-6", "deepseek-chat")
#       → Anthropic SDK path (uses ANTHROPIC_* credentials)
#   - Prefixed (e.g. "openai/gpt-4o-mini", "deepseek/deepseek-chat")
#       → litellm path (uses LITELLM_* / OPENAI_* credentials)
MODEL_ID=claude-sonnet-4-6

# Optional: model to switch to if the primary is overloaded
# (Anthropic backend only)
# FALLBACK_MODEL_ID=claude-haiku-4-5-20251001


# ── 2. Anthropic backend credentials ─────────────────────────────────
# Used when MODEL_ID has no provider prefix.
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MINI_CC_ANTHROPIC_API_KEY=sk-ant-xxx   # alias (same effect)
# MINI_CC_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Anthropic-compatible third-party endpoints (set ANTHROPIC_BASE_URL too):
#   Provider         MODEL_ID              Base URL
#   Anthropic        claude-sonnet-4-6     (default)
#   MiniMax          MiniMax-M2.5          https://api.minimax.io/anthropic
#   GLM (Zhipu)      glm-5                 https://z.ai/api/anthropic
#   Kimi (Moonshot)  kimi-k2.5             https://api.moonshot.ai/anthropic
#   DeepSeek         deepseek-v4-flash     https://api.deepseek.com/anthropic


# ── 3. litellm / OpenAI-compatible backend ───────────────────────────
# Used when MODEL_ID has a provider prefix.
# Two env names are accepted (LITELLM_* takes priority over OPENAI_*).
# Examples:
#   MODEL_ID=openai/gpt-4o-mini
#   MODEL_ID=deepseek/deepseek-chat
#   MODEL_ID=qwen/qwen-plus
#   MODEL_ID=groq/llama-3.1-70b-versatile
#
# LITELLM_API_KEY=sk-xxx
# LITELLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxx           # fallback when LITELLM_* unset
# OPENAI_BASE_URL=https://api.openai.com/v1
# MINI_CC_LITELLM_API_KEY=sk-xxx  # alias
# MINI_CC_LITELLM_BASE_URL=...    # alias


# ── 4. Tool integrations ─────────────────────────────────────────────
# Tavily — powers the `web_search` tool. Without it, the tool returns
# a clear "not configured" error so the agent can fall back to web_fetch.
# Get yours at https://tavily.com/
# TAVILY_API_KEY=tvly-xxx
# MINI_CC_TAVILY_API_KEY=tvly-xxx   # alias


# ── 5. Server bind + CORS ────────────────────────────────────────────
# MINI_CC_HOST=127.0.0.1
# MINI_CC_PORT=8000
# MINI_CC_CORS_ORIGINS=*
#   Comma-separated allow-list. Set to the UI origin in production when
#   not using the static-frontend mount (section 10).

# Root directory for projects, sessions, tenant layouts, keys, metrics,
# plugin tiers, etc. (default: ./mini_cc_data)
# MINI_CC_DATA_DIR=./mini_cc_data


# ── 6. Rate limiting (per-tenant RPM) ────────────────────────────────
# MINI_CC_RATE_LIMIT_RPM_DEFAULT=60
# MINI_CC_RATE_LIMIT_RPM=acme=120,ci-runner=300
#   Format: tenant=rpm,tenant=rpm,...
#   Overrides default for the named tenants. Useful for paying customers
#   or CI runners that need bursts.


# ── 7. Logging ───────────────────────────────────────────────────────
# MINI_CC_LOG_FORMAT=json        # json | text
# MINI_CC_LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR


# ── 8. Observability (OpenTelemetry) ─────────────────────────────────
# When MINI_CC_OTEL_EXPORTER is set, traces also export via OTel.
# Otherwise traces only land in the structured logs.
# MINI_CC_OTEL_EXPORTER=otlp     # otlp | jaeger | console | (unset)
# MINI_CC_OTEL_ENDPOINT=http://localhost:4317    # OTLP gRPC endpoint
# MINI_CC_OTEL_SERVICE_NAME=mini-cc


# ── 9. Sandbox (subprocess vs container) ─────────────────────────────
# Default sandbox kind for tenants that don't carry a per-tenant
# sandbox.toml. Container tenants auto-degrade to subprocess if the
# Docker daemon is unreachable (DegradeEvent recorded for metrics).
# Resolution order: tenant sandbox.toml → this env var → subprocess.
# MINI_CC_SANDBOX_DEFAULT=subprocess    # subprocess | container

# ── 9b. OpenSandbox backend (Phase P6) ──────────────────────────────
# 当 MINI_CC_SANDBOX_BACKEND=opensandbox 时启用。三级 fallback：
#   opensandbox → docker → subprocess
# 默认指向开发机 172.28.76.178:11123（smoke 验证通过）。
MINI_CC_SANDBOX_BACKEND=auto
OPEN_SANDBOX_DOMAIN=172.28.76.178:11123
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_API_KEY=sk-opensandbox-123456


# ── 10. Static frontend mount ────────────────────────────────────────
# When set (or when mini_cc/web/dist exists), the built React UI is
# served from the FastAPI app at /. Production deployments use this so
# only one origin is needed (no CORS). Build the UI with:
#     cd mini_cc/web && npm run build
# MINI_CC_WEB_DIST=./mini_cc/web/dist


# ── 11. Plugin discovery (MCP escape hatch) ──────────────────────────
# Preferred: drop .mcp.json into <data_dir>/.mini_cc/ (any tier).
# This env var is the legacy escape hatch — it overrides disk on name
# clash and applies last in the merge chain (system → tenant → project
# → this env). JSON shape, same per-entry layout as .mcp.json entries:
#
#   {"docs": {"command": ["npx", "mcp-server-docs"]},
#    "remote": {"type": "http", "url": "https://example.com/mcp",
#               "headers": {"Authorization": "Bearer ..."}}}
#
# MINI_CC_MCP_SERVERS={"docs": {"command": ["npx", "mcp-server-docs"]}}
